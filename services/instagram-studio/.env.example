# Node.js 24 이상. 값을 입력한 뒤 서버를 재시작하세요.
HOST=127.0.0.1
PORT=4318
BASE_PATH=/dm
# 외부 서버에서는 HOST=0.0.0.0, 아래 HTTPS 주소와 강력한 관리자 암호 필수
PUBLIC_BASE_URL=
ADMIN_PASSWORD=
# Meta 개발자 앱 > Instagram API with Instagram Login
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# 계정 로그인 방식: 운영자가 최초 한 번만 설정합니다.
# Instagram 제품 안의 앱 ID/시크릿이며 Meta 최상위 앱 ID와 다를 수 있습니다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 32바이트 난수: hex 64자 또는 표준 base64. npm run setup으로 생성. 변경하면 저장 토큰 복원 불가.
TOKEN_ENCRYPTION_KEY=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=
# 앱 대시보드에서 지원하는 Graph API 버전을 명시하세요. 예: v26.0
GRAPH_API_VERSION=
# 실발송은 환경변수와 관리 화면 모두 켜야 합니다.
ALLOW_LIVE_SEND=false
# 릴스 게시 권한 instagram_business_content_publish를 받은 뒤 활성화
ALLOW_REEL_PUBLISH=false
DATA_DIR=./data
